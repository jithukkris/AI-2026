# Copy to .env and edit. Never commit .env.

# --- Profiles: "postgres" (docker DB) and optionally "claude" (real AI) ---
SPRING_PROFILES_ACTIVE=postgres
# SPRING_PROFILES_ACTIVE=postgres,claude

# --- Claude API (only needed with the "claude" profile) ---
# Get a key at https://console.anthropic.com  (API usage is billed separately from Claude.ai plans)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Database ---
DB_PASSWORD=change-me

# --- Login users (change before exposing to the internet!) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin
VIEWER_USER=viewer
VIEWER_PASSWORD=change-me-viewer

# --- Healing policy ---
AUTO_HEAL_LIMIT=5000
MIN_CONFIDENCE=0.80
HEAL_CYCLE_MS=30000

# --- Misc ---
DISPLAY_ZONE=Asia/Kolkata
SEED_ON_STARTUP=true
